/*
 * Template user_settings.h, read in place of the generated options.h. Copy
 * it to "user_settings.h" on the include path and build wolfCert and the
 * application with -DWOLFCERT_USER_SETTINGS. See docs/EMBEDDED.md.
 *
 * Disable a feature by commenting its line out. The code tests with #ifdef,
 * so "#define WOLFCERT_HAVE_X 0" still enables it.
 *
 * wolfSSL's WOLFSSL_USER_SETTINGS macros can live in this same file. Both
 * libraries include "user_settings.h" unqualified, so only one file by that
 * name may be on the include path.
 */

#ifndef WOLFCERT_USER_SETTINGS_H
#define WOLFCERT_USER_SETTINGS_H

/* Protocols */
#define WOLFCERT_HAVE_EST    1   /* EST  (RFC 7030) */
#define WOLFCERT_HAVE_SCEP   1   /* SCEP (RFC 8894) - requires WOLFCERT_HAVE_RSA */
#define WOLFCERT_HAVE_SERVER 1   /* built-in EST/SCEP test server */

/* Platform: each needs its HAVE or WOLFCERT_NO_* form; NO_* compiles the
 * backend out and the application supplies its own transport / store ops. */
#define WOLFCERT_HAVE_POSIX_STORE 1
#define WOLFCERT_HAVE_BUILTIN_TRANSPORT 1

/* Key algorithms (at least one) */
#define WOLFCERT_HAVE_RSA     1
#define WOLFCERT_HAVE_ECC     1
#define WOLFCERT_HAVE_ED25519 1
#define WOLFCERT_HAVE_ED448   1
#define WOLFCERT_HAVE_MLDSA   1

/* wolfSSL setting for a hosted target sharing this file: makes the error
 * state per-thread (wolfSSL ignores it on FreeRTOS and Zephyr). */
/* #define HAVE_THREAD_LS */

#endif /* WOLFCERT_USER_SETTINGS_H */
